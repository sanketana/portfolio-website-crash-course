---
// STEP 5 · A content collection
// Adds:      a collection with a schema, and a write-ups list on the home page built from it
// Ends with: fails: the build stops; the schema rejects the given write-up because it has no summary
// Run:       npm run dev  →  read the error in the terminal and the browser

// [PASTE · step 2] Bring in the shared layout — ask: what does Base give this page that it didn't have?
import Base from '../layouts/Base.astro';

// [PASTE · step 5] Ask the collection for every write-up, newest first — ask: does this run at build time or in the visitor's browser?
import { getCollection } from 'astro:content';
const writeups = (await getCollection('writeups')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<!-- step 2: everything below wrapped in the shared layout -->
<Base title="Mira Varma, Application Security Lead">
  <!-- [TYPE · step 1] Who Mira is: her name as the main heading, her role, and a two-sentence intro -->
  <h1>Mira Varma</h1>
  <p class="role">Application Security Lead, Bengaluru</p>
  <p>I help product teams find and fix security flaws before attackers do. Twelve years in application security, from banking apps to hospital platforms.</p>

  <!-- [TYPE · step 1] What she does: a heading and a list of four skills -->
  <h2>What I do</h2>
  <ul>
    <li>Threat modelling for new features</li>
    <li>Secure code reviews</li>
    <li>Penetration testing of web and mobile apps</li>
    <li>Incident response and post-mortems</li>
  </ul>

  <!-- [PASTE · step 5] One list item per write-up in the collection — ask: how many <li> will the browser receive? -->
  <h2>Write-ups</h2>
  <ul class="writeups">
    {writeups.map((w) => (
      <li>
        <h3>{w.data.title}</h3>
        <p>{w.data.summary}</p>
      </li>
    ))}
  </ul>
</Base>
