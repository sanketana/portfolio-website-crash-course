@@ -0,0 +1,22 @@
+---
+// [PASTE · step 6] Bring in the collection tools and the shared layout
+import { getCollection, render } from 'astro:content';
+import Base from '../../layouts/Base.astro';
+
+// [INVESTIGATE · step 6] One page per write-up — predict: when does this run, and how many pages will it make?
+export async function getStaticPaths() {
+  const writeups = await getCollection('writeups');
+  return writeups.map((w) => ({ params: { id: w.id }, props: { w } }));
+}
+
+// [PASTE · step 6] Turn this write-up's Markdown into HTML — ask: where does <Content /> come from?
+const { w } = Astro.props;
+const { Content } = await render(w);
+---
+<!-- [PASTE · step 6] The write-up page: a way home, the title, the date and the Markdown body -->
+<Base title={`${w.data.title} | Mira Varma`}>
+  <p><a href={import.meta.env.BASE_URL}>← All write-ups</a></p>
+  <h1>{w.data.title}</h1>
+  <p class="meta">{w.data.date.toDateString()}</p>
+  <Content />
+</Base>
