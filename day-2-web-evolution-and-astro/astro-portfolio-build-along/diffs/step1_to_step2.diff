@@ -0,0 +1,36 @@
+---
+// [PASTE · step 2] The layout takes one input from each page: its title — ask: which page passes which title?
+const { title } = Astro.props;
+---
+<!-- [INVESTIGATE · step 2] The shell every page shares — predict: what happens to the page if you delete <slot />? -->
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>{title}</title>
+  </head>
+  <body>
+    <main>
+      <slot />
+    </main>
+    <footer>Mira Varma is a fictional person, made for a Sanketana class.</footer>
+  </body>
+</html>
+
+<style is:global>
+  /* [TYPE · step 2] Mira's three colours: text, accent and background */
+  :root {
+    --ink: #10233f;
+    --accent: #0f766e;
+    --paper: #f7f6f2;
+  }
+
+  /* [INVESTIGATE · step 2] Page styles that use those colours — predict: what changes if you edit --accent? */
+  body { margin: 0; background: var(--paper); color: var(--ink); font: 17px/1.6 system-ui, sans-serif; }
+  main { max-width: 680px; margin: 0 auto; padding: 48px 20px; }
+  h1 { font-size: 2.6rem; line-height: 1.1; margin: 0; }
+  h2 { margin-top: 2.5rem; color: var(--accent); }
+  a { color: var(--accent); }
+  .role { color: var(--accent); font-weight: 600; margin-top: 6px; }
+  footer { text-align: center; font-size: 14px; opacity: 0.7; padding: 24px; }
+</style>
